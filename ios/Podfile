# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# livekit_client 2.5.x pins WebRTC-SDK = 137.7151.03 while flutter_webrtc 1.3.1 pins
# 137.7151.12. Rewrite livekit's podspec to the same M137 patch before resolution so
# CocoaPods can resolve a single WebRTC-SDK version. Idempotent — no-op if already patched.
livekit_podspec = File.join(__dir__, '.symlinks/plugins/livekit_client/ios/livekit_client.podspec')
if File.exist?(livekit_podspec)
  content = File.read(livekit_podspec)
  patched = content.gsub("'WebRTC-SDK', '137.7151.03'", "'WebRTC-SDK', '137.7151.12'")
  File.write(livekit_podspec, patched) if patched != content
end

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

def patch_dk_image_picker_controller
  # DKImagePickerController 4.3.9 uses the deprecated UIApplication.shared.keyWindow
  # (deprecated iOS 15). Apple's binary scanner flags this. Patch all occurrences to use
  # the modern connectedScenes API (requires iOS 13+, below our minimum).
  files = {
    'Pods/DKImagePickerController/Sources/DKImagePickerController/DKImagePickerController.swift' => [
      [
        "targetVC = UIApplication.shared.keyWindow!.rootViewController!",
        "targetVC = UIApplication.shared.connectedScenes\n" \
        "                .compactMap { $0 as? UIWindowScene }\n" \
        "                .flatMap { $0.windows }\n" \
        "                .first { $0.isKeyWindow }?.rootViewController ?? UIApplication.shared.windows.first?.rootViewController ?? self"
      ],
      [
        "UIApplication.shared.keyWindow!.rootViewController!.dismiss(animated: true,\n" \
        "                                                                        completion: completion)",
        "let keyVC = UIApplication.shared.connectedScenes\n" \
        "                .compactMap { $0 as? UIWindowScene }\n" \
        "                .flatMap { $0.windows }\n" \
        "                .first { $0.isKeyWindow }?.rootViewController\n" \
        "            keyVC?.dismiss(animated: true, completion: completion)"
      ]
    ],
    'Pods/DKImagePickerController/Sources/DKImagePickerController/DKPopoverViewController.swift' => [
      [
        "let window = UIApplication.shared.keyWindow!\n" \
        "        \n" \
        "        let popoverViewController = DKPopoverViewController()\n" \
        "        \n" \
        "        popoverViewController.arrowColor = arrowColor\n" \
        "        popoverViewController.contentViewController = viewController\n" \
        "        popoverViewController.fromView = fromView\n" \
        "        \n" \
        "        popoverViewController.showInView(window)\n" \
        "        window.rootViewController!.addChild(popoverViewController)",
        "guard let window = UIApplication.shared.connectedScenes\n" \
        "            .compactMap({ $0 as? UIWindowScene })\n" \
        "            .flatMap({ $0.windows })\n" \
        "            .first(where: { $0.isKeyWindow }) else { return }\n\n" \
        "        let popoverViewController = DKPopoverViewController()\n\n" \
        "        popoverViewController.arrowColor = arrowColor\n" \
        "        popoverViewController.contentViewController = viewController\n" \
        "        popoverViewController.fromView = fromView\n\n" \
        "        popoverViewController.showInView(window)\n" \
        "        window.rootViewController?.addChild(popoverViewController)"
      ],
      [
        "let window = UIApplication.shared.keyWindow!\n" \
        "        \n" \
        "        for vc in window.rootViewController!.children {",
        "guard let window = UIApplication.shared.connectedScenes\n" \
        "            .compactMap({ $0 as? UIWindowScene })\n" \
        "            .flatMap({ $0.windows })\n" \
        "            .first(where: { $0.isKeyWindow }) else { return }\n\n" \
        "        for vc in window.rootViewController?.children ?? [] {"
      ]
    ],
    'Pods/DKImagePickerController/Sources/Extensions/DKImageExtensionGallery.swift' => [
      [
        "UIApplication.shared.keyWindow!.rootViewController!.present(photoGallery: gallery)",
        "let keyVC = UIApplication.shared.connectedScenes\n" \
        "                    .compactMap { $0 as? UIWindowScene }\n" \
        "                    .flatMap { $0.windows }\n" \
        "                    .first { $0.isKeyWindow }?.rootViewController\n" \
        "                keyVC?.present(photoGallery: gallery)"
      ]
    ]
  }

  files.each do |relative_path, replacements|
    file_path = File.join(File.dirname(__FILE__), relative_path)
    next unless File.exist?(file_path)
    File.chmod(0644, file_path)
    content = File.read(file_path)
    replacements.each do |old_str, new_str|
      content = content.gsub(old_str, new_str)
    end
    File.write(file_path, content)
  end
end

post_install do |installer|
  patch_dk_image_picker_controller

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Enable permission_handler permissions for iOS
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
      ]

      # Ensure all pods compile for iOS 15+ so modern UIWindowScene APIs are available
      # without #available guards. Without this, pods with lower podspec minimums
      # (e.g. DKImagePickerController targeting iOS 9) would fail to compile against
      # connectedScenes / UIWindowScene APIs. 15.0 is also App Store Connect's
      # MinimumOSVersion floor from Spring 2027 (error 90068).
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end

    end
  end
end
